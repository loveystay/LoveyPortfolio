# Supabase Dashboard > Project Settings > API.
# These values are safe to expose to the Vite client; never add service_role here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Server-side only. Used by Supabase Edge Functions during local development.
# Never prefix this value with VITE_ or commit a real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"
